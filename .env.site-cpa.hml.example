# Template seguro — env do ERP Base44 HML (PROVISIONAMENTO-HML-01 / GO-LIVE-HML-01).
# Preencher SOMENTE no secret store / Deno.env do app Base44 HML.
# Nunca commitar valores reais. Nomes canônicos do código (sem aliases inventados).
#
# Localizacao: Deno.env.get('<NOME>') em legacyIntegrationsMirror → siteCpaS2SPolicy.
# URL do gateway NAO e env do ERP; o Site (FASE 2) usara ERP_BASE_URL apontando para:
#   POST {BASE44_SERVER_URL}/api/apps/{APP_ID}/functions/legacyIntegrationsMirror
#
# Aliases investigados e AUSENTES no ERP: ERP_SERVICE_TOKEN, ERP_HMAC_SECRET,
# ERP_GROUP_ID, ERP_EMPRESA_ID, SITE_CPA_BASE_URL, SITE_CPA_ALLOWED_ORIGIN, SITE_CPA_ENV.

# --- Autenticacao S2S (siteCpaS2SPolicy/entry.ts) ---
# Token Bearer do servico SITE_CPA. Obrigatorio para o gateway (inclusive siteHealth).
SITE_CPA_SERVICE_TOKEN=
# Segredo HMAC-SHA256 das assinaturas x-site-cpa-signature. Obrigatorio.
SITE_CPA_HMAC_SECRET=

# --- Escopo multiempresa (resolvido no servidor; payload nao e fonte de verdade) ---
# groupId canonico do Grupo HML (ID real da entidade no runtime).
SITE_CPA_GROUP_ID=
# Empresa juridica padrao quando o payload omite empresaId.
SITE_CPA_DEFAULT_EMPRESA_ID=
# Lista CSV de empresaIds permitidos (deve incluir a default).
SITE_CPA_ALLOWED_EMPRESA_IDS=

# --- Rate limit do gateway S2S ---
# Maximo de requisicoes por janela (padrao interno 120 se vazio).
SITE_CPA_RATE_LIMIT=
# Janela em milissegundos (padrao interno 60000 se vazio).
SITE_CPA_RATE_WINDOW_MS=

# --- Pagamento por Empresa (FASE 5 — nao provisionar na Fase 1) ---
# Sufixo = empresaId normalizado: [^A-Za-z0-9] -> _ e UPPERCASE.
SITE_CPA_PAYMENT_API_KEY_HML_EMPRESA_CPA=
SITE_CPA_PAYMENT_WEBHOOK_SECRET_HML_EMPRESA_CPA=
SITE_CPA_PAYMENT_CUSTOMER_ID_HML_EMPRESA_CPA=
SITE_CPA_PAYMENT_WEBHOOK_RATE_LIMIT=
SITE_CPA_PAYMENT_API_KEY=
SITE_CPA_PAYMENT_WEBHOOK_SECRET=
SITE_CPA_PAYMENT_CUSTOMER_ID=

# --- Blockers externos (checklist humano — sem URL/segredo aqui) ---
# SITE_HML_CONNECTION — app Base44 HML + URL do legacyIntegrationsMirror.
# S2S_REAL_CREDENTIAL — token/HMAC no Deno.env (nunca no Git/chat).
# HML_GROUP_EMPRESA_ENTITIES — criar CPA HOMOLOGACAO no runtime.
# HML_DATASET_MATERIALIZATION — clientes/produtos/obras HML no runtime.
# PRIVATE_STORAGE / MALWARE_SCANNER / DWG / AI / OUTBOUND — fases futuras.
