# Template seguro para homologacao Site CPA (GO-LIVE-HML-01 / Opcao A).
# Preencher SOMENTE no ambiente HML provisionado. Nunca commitar valores reais.
# Nomes inventariados a partir do codigo em base44/functions/_lib/security (sem aliases inventados).

# --- Autenticacao S2S (siteCpaS2SPolicy/entry.ts) ---
# Token Bearer do servico SITE_CPA. Obrigatorio para o gateway.
SITE_CPA_SERVICE_TOKEN=
# Segredo HMAC-SHA256 das assinaturas x-site-cpa-signature. Obrigatorio.
SITE_CPA_HMAC_SECRET=

# --- Escopo multiempresa (resolvido no servidor; payload nao e fonte de verdade) ---
# groupId canonico do Grupo CPA em HML.
SITE_CPA_GROUP_ID=
# Empresa juridica padrao quando o payload omite empresaId.
SITE_CPA_DEFAULT_EMPRESA_ID=
# Lista CSV de empresaIds permitidos (deve incluir a default).
SITE_CPA_ALLOWED_EMPRESA_IDS=

# --- Rate limit do gateway S2S ---
# Maximo de requisicoes por janela (padrao interno 120 se vazio).
SITE_CPA_RATE_LIMIT=
# Janela em milissegundos (padrao interno 60000 se vazio).
SITE_CPA_RATE_WINDOW_MS=

# --- Pagamento por Empresa (siteCpaPayment/provider.ts) ---
# Sufixo = empresaId normalizado: [^A-Za-z0-9] -> _ e UPPERCASE.
# Exemplo de nomes reais usados pelo codigo (substituir HML_EMPRESA_CPA pelo sufixo da empresa HML):
SITE_CPA_PAYMENT_API_KEY_HML_EMPRESA_CPA=
SITE_CPA_PAYMENT_WEBHOOK_SECRET_HML_EMPRESA_CPA=
SITE_CPA_PAYMENT_CUSTOMER_ID_HML_EMPRESA_CPA=
# Limite de webhook de provider (siteCpaPaymentWebhook). Inteiro positivo.
SITE_CPA_PAYMENT_WEBHOOK_RATE_LIMIT=
# Fallbacks genericos (sem sufixo) tambem sao lidos pelo provider, se presentes.
SITE_CPA_PAYMENT_API_KEY=
SITE_CPA_PAYMENT_WEBHOOK_SECRET=
SITE_CPA_PAYMENT_CUSTOMER_ID=

# --- Blockers externos (nao sao env do gateway; checklist Opcao B — sem URL/segredo aqui) ---
# SITE_HML_CONNECTION — runtime HML do ERP (provisionar fora do Git; nao inventar URL).
# S2S_REAL_CREDENTIAL — token/HMAC reais no secret store do ambiente (nunca no repo).
# PRIVATE_STORAGE — assinador para portal documento e provas de entrega.
# MALWARE_SCANNER — anexos de chat/armacao.
# DWG_CONVERTER — conversao tecnica futura.
# AI_PROVIDER — Copiloto generativo (COMMERCIAL_COPILOT permanece degraded sem isso).
# OUTBOUND_MESSAGING — SMTP/WhatsApp; nucleo S2S marca not_required.
