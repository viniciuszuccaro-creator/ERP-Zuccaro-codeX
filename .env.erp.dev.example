# =============================================================================
# Template para /opt/erp-zuccaro/.env.erp.dev no VPS (FORA do Git com secrets).
# Copiar, preencher placeholders, chmod 600.
# NUNCA versionar valores reais.
# =============================================================================

NODE_ENV=production
ERP_ENV=dev
PORT=3080
APP_VERSION=0.1.0-runtime-01
REQUIRE_DATABASE=true

# Host interno do Postgres no compose Supabase (tipicamente "db").
# Descobrir: docker network inspect <NETWORK> | menos
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/postgres

# Opcional neste lote (Auth completa vem depois). Nao enviar ao browser.
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# DAM / Storage (opt-in na VPS; ausente = StoragePort desligado). Nao versionar valores reais.
SUPABASE_STORAGE_PUBLIC_URL=
SUPABASE_STORAGE_PRIVATE_BUCKET=
SUPABASE_STORAGE_MAX_BYTES=10000000
# Scanner: so liga com socket; padrao ausente = desligado. Homologar clamd antes de ativar.
# CLAMD_SOCKET_PATH=/run/clamav/clamd.ctl
# CLAMD_TIMEOUT_MS=10000

# Validacao local sem DNS: frontend em 127.0.0.1:3081
# Quando DNS ativar, acrescentar https://erp-dev.cpaferroeaco.com.br
CORS_ORIGINS=http://127.0.0.1:3081,http://localhost:3081,http://localhost:5173,https://erp-dev.cpaferroeaco.com.br

BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Preencher com o nome REAL da network (docker network ls).
ERP_DOCKER_NETWORK=<SUPABASE_DOCKER_NETWORK>
ERP_DOCKER_NETWORK_EXTERNAL=true
