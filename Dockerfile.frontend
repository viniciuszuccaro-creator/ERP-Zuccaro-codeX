# Frontend ERP (Vite build) — Hostinger / nginx
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
ARG VITE_ERP_BACKEND=http
ARG VITE_ERP_API_BASE_URL=
ARG VITE_ERP_API_SAME_ORIGIN=true
ENV VITE_ERP_BACKEND=$VITE_ERP_BACKEND
ENV VITE_ERP_API_BASE_URL=$VITE_ERP_API_BASE_URL
ENV VITE_ERP_API_SAME_ORIGIN=$VITE_ERP_API_SAME_ORIGIN
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx-erp.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
