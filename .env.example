# =============================================================================
# ERP-RUNTIME-01 — variaveis de ambiente (EXEMPLO — sem segredos reais)
# Copiar para .env.erp.dev no VPS / maquina local. NUNCA versionar valores reais.
# =============================================================================

# --- Frontend (Vite) ---
VITE_ERP_BACKEND=local
# Valores: local | http | remote
# local  = localBase44 (default DEV)
# http   = HttpApiClient → BFF
# remote = SDK Base44 legado (sandbox apenas)

VITE_ERP_API_BASE_URL=http://localhost:3080
# Futuro DEV: https://api-erp-dev.cpaferroeaco.com.br

# --- Opt-in de telas/fluxos HTTP (ausência ≠ falha de importação Legado) ---
# Sem estes flags, SPA pode abrir layout mas cair em localBase44 / sem BFF:
# VITE_ERP_HTTP_EXPEDICAO=true          # Entrega/Romaneio/Separação via BFF
# VITE_ERP_HTTP_CLIENTE_360=true        # painel Central Cliente 360 HTTP
# VITE_ERP_HTTP_PRODUTO=true            # formulário Produto V22 preparedEntities
# VITE_ERP_API_SAME_ORIGIN=true         # nginx proxy same-origin (deploy 3081)

# Backend ledger Expedição (server .env) — default false; exige DATABASE_URL:
# EXPEDICAO_PERSISTENT_PORTS=true

# Escopo opcional no browser (JSON em localStorage key erp_runtime_scope):
# {"groupId":"uuid","empresaId":"uuid","actorEmail":"dev@example.com"}

# --- Backend / BFF ---
NODE_ENV=development
ERP_ENV=dev
PORT=3080
APP_VERSION=0.1.0-runtime-01
REQUIRE_DATABASE=false

# PostgreSQL do Supabase self-hosted (somente server-side)
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/postgres

# Supabase self-hosted (server-side; service role NUNCA no browser)
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=CHANGE_ME_ANON
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE

# CORS (lista separada por virgula — sem wildcard)
# DEV local Hostinger: 127.0.0.1:3081 | Futuro DNS: https://erp-dev.cpaferroeaco.com.br
CORS_ORIGINS=http://127.0.0.1:3081,http://localhost:3081,http://localhost:5173,https://erp-dev.cpaferroeaco.com.br

BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Docker Compose ERP (opcional)
ERP_DOCKER_NETWORK=supabase_default
ERP_DOCKER_NETWORK_EXTERNAL=true
